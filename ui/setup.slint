import { LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component FridaySetup inherits Window {
    title: "F.R.I.D.A.Y. Setup";
    width: 540px;
    height: 360px;
    always-on-top: true;
    no-frame: true;
    background: transparent;
    preferred-width: 540px;
    preferred-height: 360px;

    callback initialize(string, string);
    callback close-window(); // <-- This is the exact line the compiler was crying about!

    Rectangle {
        border-radius: 16px;
        background: #0b0c10;
        border-width: 1px;
        border-color: #1f2833;

        Rectangle {
            x: 30px; y: 30px; width: 220px; height: 220px;
            border-radius: 110px;
            background: #66fcf115;
        }

        VerticalBox {
            padding: 32px;
            spacing: 20px;
            alignment: center;

            VerticalBox {
                spacing: 6px;
                Text {
                    text: "F.R.I.D.A.Y. SYSTEM INIT";
                    font-size: 20px;
                    font-weight: 800;
                    color: #66fcf1;
                    horizontal-alignment: center;
                }
                Text {
                    text: "Authenticate secure local pipeline nodes.";
                    font-size: 12px;
                    color: #c5c6c7;
                    horizontal-alignment: center;
                }
            }

            VerticalBox {
                spacing: 12px;
                
                gemini_input := LineEdit {
                    placeholder-text: "Enter Gemini API Key...";
                    input-type: password;
                    height: 40px;
                }
                
                eleven_input := LineEdit {
                    placeholder-text: "Enter ElevenLabs API Key...";
                    input-type: password;
                    height: 40px;
                }
            }

            HorizontalBox {
                alignment: center;
                spacing: 16px;
                padding-top: 4px;

                Rectangle {
                    width: 140px; height: 38px;
                    border-radius: 6px;
                    background: #1f2833;
                    border-width: 1px;
                    border-color: #45f3ff44;

                    TouchArea {
                        clicked => { root.close-window(); }
                    }
                    Text {
                        text: "Minimize / Exit";
                        color: #c5c6c7;
                        font-size: 12px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    width: 140px; height: 38px;
                    border-radius: 6px;
                    background: #66fcf1;

                    TouchArea {
                        clicked => { root.initialize(gemini_input.text, eleven_input.text); }
                    }
                    Text {
                        text: "Initialize";
                        color: #0b0c10;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component FridayFloatingBar inherits Window {
    title: "F.R.I.D.A.Y. Active";
    width: 200px;
    height: 38px;
    always-on-top: true;
    no-frame: true;
    background: transparent;

    in property <string> status: "Standby";
    callback trigger_mic();

    Rectangle {
        border-radius: 19px;
        background: #0b0c10ee;
        border-width: 1px;
        border-color: #66fcf166;
        
        TouchArea {
            clicked => { root.trigger_mic(); }
        }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 10px;
            alignment: start;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: #66fcf1;
                y: 15px;
            }

            Text {
                text: root.status;
                color: #ffffff;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}