import { LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

export component FridaySetup inherits Window {
    title: "F.R.I.D.A.Y. Setup";
    no-frame: true;
    background: transparent;
    always-on-top: true;
    preferred-width: 600px;
    preferred-height: 460px;

    in-out property <bool> is_dark: true;
    in-out property <string> error_msg: "";
    in-out property <bool> is_validating: false;

    callback initialize(string, string);
    callback exit_app();
    callback dismiss_window();

    // 1. Full-screen backdrop: Tapping outside the card minimizes/dismisses it
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismiss_window(); }
    }

    // 2. Central Modal Dialog
    card := Rectangle {
        width: 480px;
        height: 380px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 12px;
        background: root.is_dark ? #0b0f17 : #f4f6f9;
        border-width: 1px;
        border-color: root.is_dark ? #1e293b : #cbd5e1;

        // Cybernetic Top Accent Line
        Rectangle {
            width: parent.width - 24px;
            height: 2px;
            x: 12px;
            y: 0px;
            background: #00d2ff;
        }

        // Header / Exit Bar
        HorizontalLayout {
            padding-left: 24px;
            padding-right: 20px;
            padding-top: 18px;
            height: 48px;
            alignment: space-between;

            Text {
                text: "F.R.I.D.A.Y. // NEURAL CORE";
                font-size: 13px;
                font-weight: 800;
                letter-spacing: 1.5px;
                color: root.is_dark ? #00d2ff : #0284c7;
                vertical-alignment: center;
            }

            // Discreet Exit 'X' Button
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: root.is_dark ? #1e293b : #e2e8f0;

                TouchArea {
                    clicked => { root.exit_app(); }
                }

                Text {
                    text: "✕";
                    font-size: 12px;
                    color: root.is_dark ? #94a3b8 : #475569;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Main Form Container
        VerticalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 56px;
            spacing: 14px;

            Text {
                text: "Authenticate API Pipeline";
                font-size: 16px;
                font-weight: 700;
                color: root.is_dark ? #f8fafc : #0f172a;
            }

            Text {
                text: "Connect your endpoints to initialize voice recognition and reasoning nodes.";
                font-size: 11px;
                color: root.is_dark ? #64748b : #64748b;
            }

            // Input Fields with Direct Hitboxes
            gemini_in := LineEdit {
                placeholder-text: "Gemini API Key (Required)...";
                input-type: password;
                height: 40px;
            }

            eleven_in := LineEdit {
                placeholder-text: "ElevenLabs API Key (Optional)...";
                input-type: password;
                height: 40px;
            }

            // Error Status Message
            if root.error_msg != "": Text {
                text: root.error_msg;
                font-size: 11px;
                font-weight: 600;
                color: #ef4444;
                horizontal-alignment: center;
            }

            // Action Button
            HorizontalLayout {
                alignment: end;
                padding-top: 6px;

                Rectangle {
                    width: 140px;
                    height: 40px;
                    border-radius: 6px;
                    background: root.is_validating ? #0369a1 : #0284c7;

                    TouchArea {
                        clicked => {
                            root.initialize(gemini_in.text, eleven_in.text);
                        }
                    }

                    Text {
                        text: root.is_validating ? "Verifying..." : "Initialize Core";
                        color: #ffffff;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component FridayFloatingBar inherits Window {
    title: "F.R.I.D.A.Y. Active";
    no-frame: true;
    background: transparent;
    always-on-top: true;
    
    // Dynamic width: expands on hover
    width: touch.has-hover ? 200px : 36px;
    height: 36px;
    
    in-out property <bool> is_dark: true;
    in-out property <int> mic_mode: 2; // 0: Muted, 1: Live, 2: PTT
    in-out property <bool> is_listening: false; // True when PTT hotkeys are held
    
    callback set_mode(int);

    // Buttery smooth expansion animation
    animate width { duration: 250ms; easing: ease-out-circ; }

    Rectangle {
        width: 100%; height: 100%;
        border-radius: 18px;
        background: root.is_dark ? #0b0f17ee : #ffffffea;
        border-width: 1px;
        border-color: root.is_dark ? #1e293b : #cbd5e1;
        
        touch := TouchArea { width: 100%; height: 100%; }

        // The Ambient Orb (Changes color based on state)
        Rectangle {
            x: 10px; y: 10px;
            width: 16px; height: 16px;
            border-radius: 8px;
            background: root.mic_mode == 0 ? #ef4444 : (root.is_listening ? #22c55e : #00d2ff);
            animate background { duration: 200ms; }
        }

        // Toolbar Content (Only visible when expanded)
        HorizontalLayout {
            x: 36px;
            width: 152px;
            padding-right: 12px;
            spacing: 12px;
            alignment: end;
            opacity: touch.has-hover ? 1.0 : 0.0;
            animate opacity { duration: 150ms; delay: touch.has-hover ? 100ms : 0ms; }

            TouchArea {
                width: 24px;
                clicked => { root.set_mode(0); }
                Text { text: "🔇"; font-size: 14px; vertical-alignment: center; horizontal-alignment: center; }
            }
            TouchArea {
                width: 36px;
                clicked => { root.set_mode(2); }
                Text { text: "PTT"; font-size: 11px; font-weight: 800; color: root.mic_mode == 2 ? #00d2ff : #64748b; vertical-alignment: center; horizontal-alignment: center;}
            }
            TouchArea {
                width: 36px;
                clicked => { root.set_mode(1); }
                Text { text: "LIVE"; font-size: 11px; font-weight: 800; color: root.mic_mode == 1 ? #22c55e : #64748b; vertical-alignment: center; horizontal-alignment: center;}
            }
        }
    }
}