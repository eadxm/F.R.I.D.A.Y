import { LineEdit, VerticalBox, HorizontalBox } from "std-widgets.slint";

component PillButton {
    in property <string> text;
    in property <bool> is_active;
    in property <color> active_bg;
    in property <color> active_fg;
    in property <color> default_fg: #64748b;
    in property <length> btn_width: 48px;
    
    callback clicked <=> touch.clicked;

    Rectangle {
        width: root.btn_width;
        height: 32px;
        border-radius: 6px;
        background: root.is_active ? root.active_bg : transparent;

        touch := TouchArea {
            width: 100%;
            height: 100%;
        }

        Text {
            text: root.text;
            font-size: 11px;
            font-weight: 800;
            color: root.is_active ? root.active_fg : root.default_fg;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component FridaySetup inherits Window {
    title: "F.R.I.D.A.Y. Setup";
    no-frame: true;
    background: transparent;
    always-on-top: true;

    in-out property <bool> is_dark: true;
    in-out property <string> error_msg: "";
    in-out property <bool> is_validating: false;

    callback initialize(string, string);
    callback exit_app();
    callback minimize_app();

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.is_dark ? #05080fb3 : #ffffffb3;

        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.minimize_app(); }
        }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;

            card := Rectangle {
                width: 480px;
                height: 370px;
                border-radius: 12px;
                background: root.is_dark ? #0b0f17 : #f4f6f9;
                border-width: 1px;
                border-color: root.is_dark ? #1e293b : #cbd5e1;

                TouchArea { width: 100%; height: 100%; }

                Rectangle {
                    width: parent.width - 24px;
                    height: 2px;
                    y: 0px;
                    background: #00d2ff;
                }

                VerticalBox {
                    padding-top: 24px;
                    padding-left: 32px;
                    padding-right: 32px;
                    padding-bottom: 24px;
                    spacing: 24px;

                    HorizontalLayout {
                        alignment: space-between;
                        height: 30px;

                        Text {
                            text: "F.R.I.D.A.Y. // NEURAL CORE";
                            font-size: 13px;
                            font-weight: 800;
                            letter-spacing: 1.5px;
                            color: root.is_dark ? #00d2ff : #0284c7;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: 13px;
                            background: root.is_dark ? #1e293b : #e2e8f0;

                            TouchArea { clicked => { root.exit_app(); } }
                            Text {
                                text: "✕";
                                font-size: 12px;
                                color: root.is_dark ? #94a3b8 : #475569;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 8px;
                        Text {
                            text: "Authenticate API Pipeline";
                            font-size: 16px;
                            font-weight: 700;
                            color: root.is_dark ? #f8fafc : #0f172a;
                        }
                        Text {
                            text: "Connect your endpoints to initialize voice recognition and reasoning nodes.";
                            font-size: 11px;
                            color: #64748b;
                        }
                    }

                    VerticalLayout {
                        spacing: 12px;
                        gemini_in := LineEdit {
                            placeholder-text: "Gemini API Key (Required)...";
                            input-type: password;
                            height: 40px;
                        }
                        eleven_in := LineEdit {
                            placeholder-text: "ElevenLabs API Key (Optional)...";
                            input-type: password;
                            height: 40px;
                        }
                    }

                    if root.error_msg != "": Text {
                        text: root.error_msg;
                        font-size: 11px;
                        font-weight: 600;
                        color: #ef4444;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: end;
                        Rectangle {
                            width: 140px;
                            height: 40px;
                            border-radius: 6px;
                            background: root.is_validating ? #0369a1 : #0284c7;

                            TouchArea {
                                clicked => {
                                    root.initialize(gemini_in.text, eleven_in.text);
                                }
                            }
                            Text {
                                text: root.is_validating ? "Verifying..." : "Initialize Core";
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component FridayFloatingBar inherits Window {
    title: "F.R.I.D.A.Y. HUD";
    no-frame: true;
    background: transparent;
    always-on-top: true;
    
    width: 320px;
    height: 90px;

    in-out property <bool> is_dark: true;
    in-out property <int> mic_mode: 2; // 0: Muted, 1: Live, 2: PTT
    in-out property <bool> is_listening: false;

    callback set_mode(int);

    touch := TouchArea {
        width: 100%;
        height: 100%;

        pill := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            height: 44px;
            width: touch.has-hover ? 270px : 44px;
            border-radius: 22px;
            background: root.is_dark ? #0b0f17fa : #fffffff8;
            border-width: 1px;
            border-color: root.is_dark ? #1e293b : #cbd5e1;

            animate width { duration: 160ms; easing: ease-out; }

            // Status Orb
            Rectangle {
                x: 13px;
                y: 13px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: root.mic_mode == 0 ? #ef4444 : (root.is_listening ? #22c55e : #00d2ff);
                animate background { duration: 150ms; }
            }

            // Toolbar Controls
            if touch.has-hover : HorizontalLayout {
                x: 44px;
                y: 6px;
                width: 216px;
                height: 32px;
                spacing: 8px;
                alignment: end;

                // Mute Button
                PillButton {
                    text: "🔇";
                    btn_width: 36px;
                    is_active: root.mic_mode == 0;
                    active_bg: #ef444433;
                    active_fg: #ef4444;
                    default_fg: root.is_dark ? #94a3b8 : #64748b;
                    clicked => { root.set_mode(0); }
                }

                // PTT Button
                PillButton {
                    text: "PTT";
                    btn_width: 52px;
                    is_active: root.mic_mode == 2;
                    active_bg: root.is_dark ? #1e293b : #e2e8f0;
                    active_fg: #00d2ff;
                    default_fg: root.is_dark ? #94a3b8 : #64748b;
                    clicked => { root.set_mode(2); }
                }

                // Live Button
                PillButton {
                    text: "LIVE";
                    btn_width: 52px;
                    is_active: root.mic_mode == 1;
                    active_bg: root.is_dark ? #1e293b : #e2e8f0;
                    active_fg: #22c55e;
                    default_fg: root.is_dark ? #94a3b8 : #64748b;
                    clicked => { root.set_mode(1); }
                }
            }
        }
    }
}